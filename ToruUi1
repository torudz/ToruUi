    end)

    local Sidebar = Instance.new("Frame", MainFrame)
    Sidebar.Size = UDim2.new(0, 135, 1, -40)
    Sidebar.Position = UDim2.new(0, 0, 0, 40)
    Sidebar.BackgroundTransparency = 1

    local AuthL = Instance.new("TextLabel", Sidebar)
    AuthL.Size = UDim2.new(1, -20, 0, 18)
    AuthL.Position = UDim2.new(0, 15, 0, 0)
    AuthL.BackgroundTransparency = 1
    AuthL.Text = authorName
    AuthL.TextColor3 = Theme.TextMain
    AuthL.Font = Enum.Font.GothamBold
    AuthL.TextSize = 13
    AuthL.TextXAlignment = Enum.TextXAlignment.Left

    local FpsLabel = Instance.new("TextLabel", Sidebar)
    FpsLabel.Size = UDim2.new(1, -20, 0, 14)
    FpsLabel.Position = UDim2.new(0, 15, 0, 18)
    FpsLabel.BackgroundTransparency = 1
    FpsLabel.Text = "FPS: --"
    FpsLabel.TextColor3 = Theme.TextDark
    FpsLabel.Font = Enum.Font.Gotham
    FpsLabel.TextSize = 10
    FpsLabel.TextXAlignment = Enum.TextXAlignment.Left

    RunService.RenderStepped:Connect(function()
        FpsLabel.Text = "FPS: " .. string.format("%.1f", 1 / task.wait())
    end)

    local TabsContainer = Instance.new("Frame", Sidebar)
    TabsContainer.Size = UDim2.new(1, 0, 1, -45)
    TabsContainer.Position = UDim2.new(0, 0, 0, 45)
    TabsContainer.BackgroundTransparency = 1
    
    Instance.new("UIListLayout", TabsContainer).Padding = UDim.new(0, 5)

    -- ==========================================
    -- HÀM KHỞI TẠO TAB (CreateTab)
    -- ==========================================
    function window:CreateTab(tabName)
        local tab = {}
        
        local TabBtn = Instance.new("TextButton", TabsContainer)
        TabBtn.Size = UDim2.new(0, 110, 0, 26)
        TabBtn.Font = Enum.Font.GothamMedium
        TabBtn.TextSize = 11
        TabBtn.Text = "  " .. tabName
        TabBtn.TextXAlignment = Enum.TextXAlignment.Left
        TabBtn.BackgroundColor3 = Theme.TabInActive
        TabBtn.TextColor3 = Theme.TextDark
        Instance.new("UICorner", TabBtn).CornerRadius = UDim.new(0, 6)
        local TabStroke = Instance.new("UIStroke", TabBtn)
        TabStroke.Color = Color3.fromRGB(0,0,0)

        local Page = Instance.new("ScrollingFrame", MainFrame)
        Page.Size = UDim2.new(1, -150, 1, -70)
        Page.Position = UDim2.new(0, 138, 0, 40)
        Page.BackgroundColor3 = Theme.ContentBg
        Page.BorderSizePixel = 0
        Page.ScrollBarThickness = 2
        Page.ScrollBarImageColor3 = Theme.StrokeInActive
        Page.Visible = false
        Page.ClipsDescendants = false -- Để danh sách dropdown xổ ra không bị cắt đứt
        Instance.new("UICorner", Page).CornerRadius = UDim.new(0, 10)

        local ContentGrid = Instance.new("UIGridLayout", Page)
        ContentGrid.CellSize = UDim2.new(0, 190, 0, 28)
        ContentGrid.CellPadding = UDim2.new(0, 10, 0, 6)

        ContentGrid:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            Page.CanvasSize = UDim2.new(0, 0, 0, ContentGrid.AbsoluteContentSize.Y + 15)
        end)

        window.Tabs[tabName] = TabBtn
        window.Pages[tabName] = Page

        local function activate()
            for name, p in pairs(window.Pages) do p.Visible = (name == tabName) end
            for name, b in pairs(window.Tabs) do
                if name == tabName then
                    b.BackgroundColor3 = Theme.TabActive
                    b.TextColor3 = Theme.TextMain
                    b.UIStroke.Color = Theme.StrokeActive
                else
                    b.BackgroundColor3 = Theme.TabInActive
                    b.TextColor3 = Theme.TextDark
                    b.UIStroke.Color = Color3.fromRGB(0,0,0)
                end
            end
        end

        TabBtn.MouseButton1Click:Connect(activate)
        if not window.CurrentTab then activate() window.CurrentTab = tabName end

        -- ==========================================
        -- THÀNH PHẦN: ADD TOGGLE
        -- ==========================================
        function tab:AddToggle(text, default, callback)
            callback = callback or function() end
            local Container = Instance.new("Frame", Page)
            Container.BackgroundTransparency = 1

            local Box = Instance.new("TextButton", Container)
            Box.Size = UDim2.new(0, 14, 0, 14)
            Box.Position = UDim2.new(0, 10, 0.5, -7)
            Box.BackgroundColor3 = Theme.MainBg
            Box.Text = default and "✓" or ""
            Box.TextColor3 = Color3.fromRGB(150, 180, 220)
            Box.Font = Enum.Font.SourceSansBold
            Box.TextSize = 12
            
            local BoxStroke = Instance.new("UIStroke", Box)
            BoxStroke.Color = default and Theme.StrokeActive or Theme.StrokeInActive
            Instance.new("UICorner", Box).CornerRadius = UDim.new(0, 4)

            local Label = Instance.new("TextLabel", Container)
            Label.Size = UDim2.new(1, -32, 1, 0)
            Label.Position = UDim2.new(0, 32, 0, 0)
            Label.BackgroundTransparency = 1
            Label.Text = text
            Label.TextColor3 = Color3.fromRGB(200, 205, 215)
            Label.Font = Enum.Font.Gotham
            Label.TextSize = 11
            Label.TextXAlignment = Enum.TextXAlignment.Left

            Box.MouseButton1Click:Connect(function()
                default = not default
                Box.Text = default and "✓" or ""
                BoxStroke.Color = default and Theme.StrokeActive or Theme.StrokeInActive
                pcall(callback, default)
            end)
        end

        -- ==========================================
        -- THÀNH PHẦN: ADD SLIDER
        -- ==========================================
        function tab:AddSlider(text, min, max, default, callback)
            callback = callback or function() end
            local Container = Instance.new("Frame", Page)
            Container.BackgroundTransparency = 1

            local Label = Instance.new("TextLabel", Container)
            Label.Size = UDim2.new(0.6, 0, 0, 12)
            Label.Position = UDim2.new(0, 10, 0, 2)
            Label.BackgroundTransparency = 1
            Label.Text = text
            Label.TextColor3 = Color3.fromRGB(200, 205, 215)
            Label.Font = Enum.Font.Gotham
            Label.TextSize = 10.5
            Label.TextXAlignment = Enum.TextXAlignment.Left

            local ValueLabel = Instance.new("TextLabel", Container)
            ValueLabel.Size = UDim2.new(0.35, 0, 0, 12)
            ValueLabel.Position = UDim2.new(0.6, 0, 0, 2)
            ValueLabel.BackgroundTransparency = 1
            ValueLabel.Text = tostring(default)
            ValueLabel.TextColor3 = Theme.StrokeActive
            ValueLabel.Font = Enum.Font.Code
            ValueLabel.TextSize = 10.5
            ValueLabel.TextXAlignment = Enum.TextXAlignment.Right

            local SlideBar = Instance.new("TextButton", Container)
            SlideBar.Size = UDim2.new(1, -20, 0, 4)
            SlideBar.Position = UDim2.new(0, 10, 0, 18)
            SlideBar.BackgroundColor3 = Theme.MainBg
            SlideBar.Text = ""
            Instance.new("UICorner", SlideBar).CornerRadius = UDim.new(0, 2)

            local Fill = Instance.new("Frame", SlideBar)
            Fill.Size = UDim2.new((default - min)/(max - min), 0, 1, 0)
            Fill.BackgroundColor3 = Theme.StrokeActive
            Instance.new("UICorner", Fill).CornerRadius = UDim.new(0, 2)

            local function updateSlider(input)
                local ratio = math.clamp((input.Position.X - SlideBar.AbsolutePosition.X) / SlideBar.AbsoluteSize.X, 0, 1)
                Fill.Size = UDim2.new(ratio, 0, 1, 0)
                local finalVal = math.floor(min + (max - min) * ratio)
                ValueLabel.Text = tostring(finalVal)
                pcall(callback, finalVal)
            end

            local sliding = false
            SlideBar.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    sliding = true; updateSlider(input)
                end
            end)
            UserInputService.InputChanged:Connect(function(input)
                if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    updateSlider(input)
                end
            end)
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    sliding = false
                end
            end)
        end

        -- ==========================================
        -- THÀNH PHẦN: ADD BUTTON
        -- ==========================================
        function tab:AddButton(text, callback)
            callback = callback or function() end
            local Container = Instance.new("Frame", Page)
            Container.BackgroundTransparency = 1

            local Btn = Instance.new("TextButton", Container)
            Btn.Size = UDim2.new(1, -20, 1, -4)
            Btn.Position = UDim2.new(0, 10, 0, 2)
            Btn.BackgroundColor3 = Theme.TabInActive
            Btn.Text = text
            Btn.TextColor3 = Theme.TextMain
            Btn.Font = Enum.Font.GothamMedium
            Btn.TextSize = 11
            
            local BtnStroke = Instance.new("UIStroke", Btn)
            BtnStroke.Color = Theme.StrokeInActive
            Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 6)

            Btn.MouseButton1Click:Connect(function()
                BtnStroke.Color = Theme.StrokeActive
                task.wait(0.1)
                BtnStroke.Color = Theme.StrokeInActive
                pcall(callback)
            end)
        end

        -- ==========================================
        -- THÀNH PHẦN MỚI: ADD DROPDOWN (MENU THẢ XUỐNG)
        -- ==========================================
        function tab:AddDropdown(text, list, default, callback)
            list = list or {}
            callback = callback or function() end
            local currentSelection = default or list[1] or "None"
            local isExpanded = false

            local Container = Instance.new("Frame", Page)
            Container.BackgroundTransparency = 1
            Container.ZIndex = 5 -- Đảm bảo đè lên các phần tử bên dưới khi xổ ra

            -- Khung bấm chính của Dropdown
            local DropBtn = Instance.new("TextButton", Container)
            DropBtn.Size = UDim2.new(1, -20, 1, -4)
            DropBtn.Position = UDim2.new(0, 10, 0, 2)
            DropBtn.BackgroundColor3 = Theme.TabInActive
            DropBtn.Text = "  " .. text .. ": " .. currentSelection
            DropBtn.TextColor3 = Color3.fromRGB(200, 205, 215)
            DropBtn.Font = Enum.Font.GothamMedium
            DropBtn.TextSize = 10.5
            DropBtn.TextXAlignment = Enum.TextXAlignment.Left
            
            local DropStroke = Instance.new("UIStroke", DropBtn)
            DropStroke.Color = Theme.StrokeInActive
            Instance.new("UICorner", DropBtn).CornerRadius = UDim.new(0, 6)

            -- Icon mũi tên chỉ trạng thái
            local Arrow = Instance.new("TextLabel", DropBtn)
            Arrow.Size = UDim2.new(0, 20, 1, 0)
            Arrow.Position = UDim2.new(1, -25, 0, 0)
            Arrow.BackgroundTransparency = 1
            Arrow.Text = "▼"
            Arrow.TextColor3 = Theme.TextDark
            Arrow.Font = Enum.Font.GothamBold
            Arrow.TextSize = 10

            -- Khung chứa danh sách các tùy chọn (Chỉ hiện khi Click)
            local DropListFrame = Instance.new("ScrollingFrame", DropBtn)
            DropListFrame.Size = UDim2.new(1, 0, 0, 0) -- Mặc định ẩn (Chiều cao = 0)
            DropListFrame.Position = UDim2.new(0, 0, 1, 2)
            DropListFrame.BackgroundColor3 = Theme.DropdownBg
            DropListFrame.BorderSizePixel = 0
            DropListFrame.Visible = false
            DropListFrame.ZIndex = 10
            DropListFrame.ScrollBarThickness = 2
            DropListFrame.ScrollBarImageColor3 = Theme.StrokeActive
            Instance.new("UICorner", DropListFrame).CornerRadius = UDim.new(0, 6)
            local ListStroke = Instance.new("UIStroke", DropListFrame)
            ListStroke.Color = Theme.StrokeActive

            local ListLayout = Instance.new("UIListLayout", DropListFrame)
            ListLayout.Padding = UDim.new(0, 2)

            -- Render các nút Item vào Dropdown
            local function refreshList()
                -- Xóa danh sách cũ tránh trùng lặp
                for _, item in pairs(DropListFrame:GetChildren()) do
                    if item:IsA("TextButton") then item:Destroy() end
                end

                for _, optionName in pairs(list) do
                    local ItemBtn = Instance.new("TextButton", DropListFrame)
                    ItemBtn.Size = UDim2.new(1, 0, 0, 22)
                    ItemBtn.BackgroundColor3 = (optionName == currentSelection) and Theme.TabActive or Color3.fromRGB(0, 0, 0)
                    ItemBtn.BackgroundTransparency = (optionName == currentSelection) and 0 or 1
                    ItemBtn.Text = "   " .. tostring(optionName)
                    ItemBtn.TextColor3 = (optionName == currentSelection) and Theme.TextMain or Theme.TextDark
                    ItemBtn.Font = Enum.Font.Gotham
                    ItemBtn.TextSize = 10
                    ItemBtn.TextXAlignment = Enum.TextXAlignment.Left
                    ItemBtn.ZIndex = 11

                    ItemBtn.MouseButton1Click:Connect(function()
                        currentSelection = optionName
                        DropBtn.Text = "  " .. text .. ": " .. tostring(currentSelection)
                        isExpanded = false
                        DropListFrame.Visible = false
                        DropListFrame.Size = UDim2.new(1, 0, 0, 0)
                        Arrow.Text = "▼"
                        pcall(callback, currentSelection)
                    end)
                end
                DropListFrame.CanvasSize = UDim2.new(0, 0, 0, ListLayout.AbsoluteContentSize.Y)
            end

            -- Bắt sự kiện đóng/mở menu thả xuống
            DropBtn.MouseButton1Click:Connect(function()
                isExpanded = not isExpanded
                if isExpanded then
                    refreshList()
                    DropListFrame.Visible = true
                    Arrow.Text = "▲"
                    -- Tính toán chiều cao linh hoạt dựa vào số item (Giới hạn tối đa 4 tầng để tránh tràn màn hình)
                    local targetHeight = math.min(#list * 24, 96)
                    tween(DropListFrame, {0.2}, {Size = UDim2.new(1, 0, 0, targetHeight)})
                else
                    Arrow.Text = "▼"
                    local t = tween(DropListFrame, {0.2}, {Size = UDim2.new(1, 0, 0, 0)})
                    t.Completed:Connect(function()
                        if not isExpanded then DropListFrame.Visible = false end
                    end)
                end
            end)
        end

        return tab
    end

    return window
end

return DeltaLib
