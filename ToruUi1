            Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 6)

            Btn.MouseButton1Click:Connect(function()
                BtnStroke.Color = Theme.StrokeActive
                task.wait(0.1)
                BtnStroke.Color = Theme.StrokeInActive
                pcall(callback)
            end)
        end

        function tab:AddDropdown(text, list, default, callback)
            list = list or {}
            callback = callback or function() end
            local currentSelection = default or list[1] or "None"
            local isExpanded = false

            local Container = Instance.new("Frame", Page)
            Container.BackgroundTransparency = 1
            Container.ZIndex = 5

            local DropBtn = Instance.new("TextButton", Container)
            DropBtn.Size = UDim2.new(1, -10, 1, -4)
            DropBtn.Position = UDim2.new(0, 5, 0, 2)
            DropBtn.BackgroundColor3 = Theme.TabInActive
            DropBtn.Text = "  " .. text .. ": " .. currentSelection
            DropBtn.TextColor3 = Color3.fromRGB(200, 205, 215)
            DropBtn.Font = Enum.Font.GothamMedium
            DropBtn.TextSize = 10.5
            DropBtn.TextXAlignment = Enum.TextXAlignment.Left
            
            local DropStroke = Instance.new("UIStroke", DropBtn)
            DropStroke.Color = Theme.StrokeInActive
            Instance.new("UICorner", DropBtn).CornerRadius = UDim.new(0, 6)

            local Arrow = Instance.new("TextLabel", DropBtn)
            Arrow.Size = UDim2.new(0, 20, 1, 0)
            Arrow.Position = UDim2.new(1, -25, 0, 0)
            Arrow.BackgroundTransparency = 1
            Arrow.Text = "▼"
            Arrow.TextColor3 = Theme.TextDark
            Arrow.Font = Enum.Font.GothamBold
            Arrow.TextSize = 10

            local DropListFrame = Instance.new("ScrollingFrame", DropBtn)
            DropListFrame.Size = UDim2.new(1, 0, 0, 0)
            DropListFrame.Position = UDim2.new(0, 0, 1, 2)
            DropListFrame.BackgroundColor3 = Theme.DropdownBg
            DropListFrame.BorderSizePixel = 0
            DropListFrame.Visible = false
            DropListFrame.ZIndex = 10
            DropListFrame.ScrollBarThickness = 2
            DropListFrame.ScrollBarImageColor3 = Theme.StrokeActive
            Instance.new("UICorner", DropListFrame).CornerRadius = UDim.new(0, 6)
            Instance.new("UIStroke", DropListFrame).Color = Theme.StrokeActive

            local ListLayout = Instance.new("UIListLayout", DropListFrame)
            ListLayout.Padding = UDim.new(0, 2)

            local function refreshList()
                for _, item in pairs(DropListFrame:GetChildren()) do
                    if item:IsA("TextButton") then item:Destroy() end
                end
                for _, optionName in pairs(list) do
                    local ItemBtn = Instance.new("TextButton", DropListFrame)
                    ItemBtn.Size = UDim2.new(1, 0, 0, 22)
                    ItemBtn.BackgroundColor3 = (optionName == currentSelection) and Theme.TabActive or Color3.fromRGB(0, 0, 0)
                    ItemBtn.BackgroundTransparency = (optionName == currentSelection) and 0 or 1
                    ItemBtn.Text = "   " .. tostring(optionName)
                    ItemBtn.TextColor3 = (optionName == currentSelection) and Theme.TextMain or Theme.TextDark
                    ItemBtn.Font = Enum.Font.Gotham
                    ItemBtn.TextSize = 10
                    ItemBtn.TextXAlignment = Enum.TextXAlignment.Left
                    ItemBtn.ZIndex = 11

                    ItemBtn.MouseButton1Click:Connect(function()
                        currentSelection = optionName
                        DropBtn.Text = "  " .. text .. ": " .. tostring(currentSelection)
                        isExpanded = false
                        DropListFrame.Visible = false
                        DropListFrame.Size = UDim2.new(1, 0, 0, 0)
                        Arrow.Text = "▼"
                        pcall(callback, currentSelection)
                    end)
                end
                DropListFrame.CanvasSize = UDim2.new(0, 0, 0, ListLayout.AbsoluteContentSize.Y)
            end

            DropBtn.MouseButton1Click:Connect(function()
                isExpanded = not isExpanded
                if isExpanded then
                    refreshList()
                    DropListFrame.Visible = true
                    Arrow.Text = "▲"
                    local targetHeight = math.min(#list * 24, 96)
                    tween(DropListFrame, {0.2}, {Size = UDim2.new(1, 0, 0, targetHeight)})
                else
                    Arrow.Text = "▼"
                    local t = tween(DropListFrame, {0.2}, {Size = UDim2.new(1, 0, 0, 0)})
                    t.Completed:Connect(function() if not isExpanded then DropListFrame.Visible = false end end)
                end
            end)
        end

        function tab:AddParagraph(title, content)
            local Container = Instance.new("Frame", Page)
            Container.BackgroundTransparency = 1

            local BgFrame = Instance.new("Frame", Container)
            BgFrame.Size = UDim2.new(1, -10, 1, -2)
