    SidebarPadding.PaddingLeft = UDim.new(0, 15)  -- Căn lề trái 15px cho các nút đều hàng với Tên/FPS

    function window:CreateTab(tabName)
        local tab = {}
        
        local TabBtn = Instance.new("TextButton", TabsContainer)
        TabBtn.Size = UDim2.new(0, 110, 0, 28)
        TabBtn.Font = Enum.Font.GothamMedium
        TabBtn.TextSize = 11
        TabBtn.Text = "  " .. tabName
        TabBtn.TextXAlignment = Enum.TextXAlignment.Left
        TabBtn.BackgroundColor3 = Theme.TabInActive
        TabBtn.TextColor3 = Theme.TextDark
        Instance.new("UICorner", TabBtn).CornerRadius = UDim.new(0, 6)
        local TabStroke = Instance.new("UIStroke", TabBtn)
        TabStroke.Color = Color3.fromRGB(0,0,0)

        local Page = Instance.new("ScrollingFrame", MainFrame)
        Page.Size = UDim2.new(1, -150, 1, -70)
        Page.Position = UDim2.new(0, 138, 0, 45)
        Page.BackgroundColor3 = Theme.ContentBg
        Page.BorderSizePixel = 0
        Page.ScrollBarThickness = 2
        Page.ScrollBarImageColor3 = Theme.StrokeInActive
        Page.Visible = false
        Page.ClipsDescendants = true
        Instance.new("UICorner", Page).CornerRadius = UDim.new(0, 10)

        local PagePadding = Instance.new("UIPadding", Page)
        PagePadding.PaddingTop = UDim.new(0, 10)
        PagePadding.PaddingLeft = UDim.new(0, 10)
        PagePadding.PaddingRight = UDim.new(0, 10)

        local ContentGrid = Instance.new("UIGridLayout", Page)
        ContentGrid.CellSize = UDim2.new(0, 190, 0, 32)
        ContentGrid.CellPadding = UDim2.new(0, 10, 0, 10)

        ContentGrid:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            Page.CanvasSize = UDim2.new(0, 0, 0, ContentGrid.AbsoluteContentSize.Y + 25)
        end)

        window.Pages[tabName] = Page
        window.Tabs[tabName] = TabBtn

        local function activate()
            for name, p in pairs(window.Pages) do p.Visible = (name == tabName) end
            for name, b in pairs(window.Tabs) do
                if name == tabName then
                    b.BackgroundColor3 = Theme.TabActive
                    b.TextColor3 = Theme.TextMain
                    b.UIStroke.Color = Theme.StrokeActive
                else
                    b.BackgroundColor3 = Theme.TabInActive
                    b.TextColor3 = Theme.TextDark
                    b.UIStroke.Color = Color3.fromRGB(0,0,0)
                end
            end
        end

        TabBtn.MouseButton1Click:Connect(activate)
        if not window.CurrentTab then activate() window.CurrentTab = tabName end

        function tab:AddToggle(text, default, callback)
            callback = callback or function() end
            local Container = Instance.new("Frame", Page)
            Container.BackgroundTransparency = 1

            local Box = Instance.new("TextButton", Container)
            Box.Size = UDim2.new(0, 14, 0, 14)
            Box.Position = UDim2.new(0, 5, 0.5, -7)
            Box.BackgroundColor3 = Theme.MainBg
            Box.Text = default and "✓" or ""
            Box.TextColor3 = Color3.fromRGB(150, 180, 220)
            Box.Font = Enum.Font.SourceSansBold
            Box.TextSize = 12
            
            local BoxStroke = Instance.new("UIStroke", Box)
            BoxStroke.Color = default and Theme.StrokeActive or Theme.StrokeInActive
            Instance.new("UICorner", Box).CornerRadius = UDim.new(0, 4)

            local Label = Instance.new("TextLabel", Container)
            Label.Size = UDim2.new(1, -25, 1, 0)
            Label.Position = UDim2.new(0, 25, 0, 0)
            Label.BackgroundTransparency = 1
            Label.Text = text
            Label.TextColor3 = Color3.fromRGB(200, 205, 215)
            Label.Font = Enum.Font.Gotham
            Label.TextSize = 11
            Label.TextXAlignment = Enum.TextXAlignment.Left

            Box.MouseButton1Click:Connect(function()
                default = not default
                Box.Text = default and "✓" or ""
                BoxStroke.Color = default and Theme.StrokeActive or Theme.StrokeInActive
                pcall(callback, default)
            end)
        end

        function tab:AddSlider(text, min, max, default, callback)
            callback = callback or function() end
            local Container = Instance.new("Frame", Page)
            Container.BackgroundTransparency = 1

            local Label = Instance.new("TextLabel", Container)
            Label.Size = UDim2.new(0.6, 0, 0, 12)
            Label.Position = UDim2.new(0, 5, 0, 2)
            Label.BackgroundTransparency = 1
            Label.Text = text
            Label.TextColor3 = Color3.fromRGB(200, 205, 215)
            Label.Font = Enum.Font.Gotham
            Label.TextSize = 10.5
            Label.TextXAlignment = Enum.TextXAlignment.Left

            local ValueLabel = Instance.new("TextLabel", Container)
            ValueLabel.Size = UDim2.new(0.35, 0, 0, 12)
            ValueLabel.Position = UDim2.new(0.6, 0, 0, 2)
            ValueLabel.BackgroundTransparency = 1
            ValueLabel.Text = tostring(default)
            ValueLabel.TextColor3 = Theme.StrokeActive
            ValueLabel.Font = Enum.Font.Code
            ValueLabel.TextSize = 10.5
            ValueLabel.TextXAlignment = Enum.TextXAlignment.Right

            local SlideBar = Instance.new("TextButton", Container)
            SlideBar.Size = UDim2.new(1, -10, 0, 4)
            SlideBar.Position = UDim2.new(0, 5, 0, 18)
            SlideBar.BackgroundColor3 = Theme.MainBg
            SlideBar.Text = ""
            Instance.new("UICorner", SlideBar).CornerRadius = UDim.new(0, 2)

            local Fill = Instance.new("Frame", SlideBar)
            Fill.Size = UDim2.new((default - min)/(max - min), 0, 1, 0)
            Fill.BackgroundColor3 = Theme.StrokeActive
            Instance.new("UICorner", Fill).CornerRadius = UDim.new(0, 2)

            local function updateSlider(input)
                local ratio = math.clamp((input.Position.X - SlideBar.AbsolutePosition.X) / SlideBar.AbsoluteSize.X, 0, 1)
                Fill.Size = UDim2.new(ratio, 0, 1, 0)
                local finalVal = math.floor(min + (max - min) * ratio)
                ValueLabel.Text = tostring(finalVal)
                pcall(callback, finalVal)
            end

            local sliding = false
            SlideBar.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    sliding = true; updateSlider(input)
                end
            end)
            UserInputService.InputChanged:Connect(function(input)
                if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    updateSlider(input)
                end
            end)
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    sliding = false
                end
            end)
        end

        function tab:AddButton(text, callback)
            callback = callback or function() end
            local Container = Instance.new("Frame", Page)
            Container.BackgroundTransparency = 1

            local Btn = Instance.new("TextButton", Container)
            Btn.Size = UDim2.new(1, -10, 1, -4)
            Btn.Position = UDim2.new(0, 5, 0, 2)
            Btn.BackgroundColor3 = Theme.TabInActive
            Btn.Text = text
            Btn.TextColor3 = Theme.TextMain
            Btn.Font = Enum.Font.GothamMedium
            Btn.TextSize = 11
            
            local BtnStroke = Instance.new("UIStroke", Btn)
