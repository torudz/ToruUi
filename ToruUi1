function DeltaLib:Notification(title, text, duration)
    duration = duration or 3
    
    local NotifFrame = Instance.new("Frame")
    NotifFrame.Size = UDim2.new(1, 0, 0, 55)
    NotifFrame.BackgroundColor3 = Theme.MainBg
    NotifFrame.BorderSizePixel = 0
    NotifFrame.Parent = NotifContainer
    
    Instance.new("UICorner", NotifFrame).CornerRadius = UDim.new(0, 8)
    local Stroke = Instance.new("UIStroke", NotifFrame)
    Stroke.Color = Theme.StrokeActive
    
    local TTitle = Instance.new("TextLabel", NotifFrame)
    TTitle.Size = UDim2.new(1, -20, 0, 20)
    TTitle.Position = UDim2.new(0, 10, 0, 5)
    TTitle.BackgroundTransparency = 1
    TTitle.Text = title
    TTitle.TextColor3 = Theme.TextMain
    TTitle.Font = Enum.Font.GothamBold
    TTitle.TextSize = 12
    TTitle.TextXAlignment = Enum.TextXAlignment.Left
    
    local TText = Instance.new("TextLabel", NotifFrame)
    TText.Size = UDim2.new(1, -20, 0, 25)
    TText.Position = UDim2.new(0, 10, 0, 22)
    TText.BackgroundTransparency = 1
    TText.Text = text
    TText.TextColor3 = Theme.TextDark
    TText.Font = Enum.Font.Gotham
    TText.TextSize = 10
    TText.TextXAlignment = Enum.TextXAlignment.Left
    TText.TextWrapped = true
    
    task.delay(duration, function()
        tween(NotifFrame, {0.3}, {BackgroundTransparency = 1})
        tween(TTitle, {0.3}, {TextTransparency = 1})
        tween(TText, {0.3}, {TextTransparency = 1})
        task.wait(0.3)
        NotifFrame:Destroy()
    end)
end

