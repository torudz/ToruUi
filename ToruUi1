            local PTitle = Instance.new("TextLabel", BgFrame)
            PTitle.Size = UDim2.new(1, -16, 0, 14)
            PTitle.Position = UDim2.new(0, 8, 0, 3)
            PTitle.BackgroundTransparency = 1
            PTitle.Text = title or "Paragraph Title"
            PTitle.TextColor3 = Theme.TextMain
            PTitle.Font = Enum.Font.GothamBold
            PTitle.TextSize = 10.5
            PTitle.TextXAlignment = Enum.TextXAlignment.Left

            local PContent = Instance.new("TextLabel", BgFrame)
            PContent.Size = UDim2.new(1, -16, 1, -18)
            PContent.Position = UDim2.new(0, 8, 0, 16)
            PContent.BackgroundTransparency = 1
            PContent.Text = content or "Paragraph Content"
            PContent.TextColor3 = Theme.TextDark
            PContent.Font = Enum.Font.Gotham
            PContent.TextSize = 9
            PContent.TextXAlignment = Enum.TextXAlignment.Left
            PContent.TextYAlignment = Enum.TextYAlignment.Top
            PContent.TextWrapped = true
        end

        return tab
    end

    return window
end

return ToruUi
